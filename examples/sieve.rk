main = ->
    limit = 100
    mut sieve = Vec::new!
    i = 0
    while i < limit
        sieve.push 1
        i = i + 1
    sieve.set 0, 0
    sieve.set 1, 0
    i = 2
    while i * i < limit
        if ((sieve.get i).unwrap_or 0) == 1
            j = i * i
            while j < limit
                sieve.set j, 0
                j = j + i
        i = i + 1
    i = 2
    while i < limit
        if ((sieve.get i).unwrap_or 0) == 1
            i.println!
        i = i + 1
    "".println!
    0
