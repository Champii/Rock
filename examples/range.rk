main = ->
    sum = 0
    for i in 1..101
        sum = sum + i
    sum.println!

    for i in 1..4
        for j in 1..4
            i * j .println!
        "".println!

    count = 0
    for n in 2..51
        is_prime = 1
        for d in 2..n
            if n % d == 0
                is_prime = 0
        if is_prime == 1
            count = count + 1
    count.println!
    0
