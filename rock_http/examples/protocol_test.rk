> stdlib::io::stdout
> stdlib::string::str_as_bytes
> stdlib::option::Option
> stdlib::result::Result
> rock_http::config::ServerConfig
> rock_http::error::HttpError
> rock_http::parser::DecodeResult
> rock_http::parser::parse_request
> rock_http::request::Method
> rock_http::request::Request
> rock_http::response::Response
> rock_http::response::write_response

validate_request: Request -> I64 -> Bool
validate_request = request, consumed ->
    method_ok = match *(&request.method)
        Method::Post => true
        _ => false
    target_ok = request.target.as_str! == "/submit"
    header_ok = match request.header "HOST"
        Option::Some value => value == "example.test"
        Option::None => false
    body_ok = request.body.len! == 5 && request.body[0] == (104 as U8) && request.body[4] == (111 as U8)
    method_ok && target_ok && header_ok && body_ok && consumed == 69

main = ->
    config = ServerConfig::default!
    partial = str_as_bytes "POST /submit HTTP/1.1\r\nHost: example.test\r\nContent-Length: 5\r\n"
    partial_ok = match parse_request partial, &config
        DecodeResult::Incomplete => true
        _ => false

    complete = str_as_bytes "POST /submit HTTP/1.1\r\nHost: example.test\r\nContent-Length: 5\r\n\r\nhello"
    complete_ok = match parse_request complete, &config
        DecodeResult::Complete request, consumed => validate_request request, consumed
        _ => false

    transfer = str_as_bytes "GET / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
    transfer_ok = match parse_request transfer, &config
        DecodeResult::Error HttpError::UnsupportedTransferEncoding => true
        _ => false

    conflict = str_as_bytes "GET / HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\n"
    conflict_ok = match parse_request conflict, &config
        DecodeResult::Error HttpError::ConflictingContentLength => true
        _ => false

    duplicate = str_as_bytes "GET / HTTP/1.1\r\nX-Value: one\r\nX-Value: two\r\n\r\n"
    duplicate_ok = match parse_request duplicate, &config
        DecodeResult::Complete request, _ =>
            values = request.headers_named "x-value"
            values.len! == 2
        _ => false

    bad_version = str_as_bytes "GET / HTTP/2\r\n\r\n"
    version_ok = match parse_request bad_version, &config
        DecodeResult::Error HttpError::UnsupportedVersion => true
        _ => false

    bad_header = str_as_bytes "GET / HTTP/1.1\r\nMissing-Colon\r\n\r\n"
    header_ok = match parse_request bad_header, &config
        DecodeResult::Error HttpError::InvalidHeader => true
        _ => false

    body_config = ServerConfig
        max_request_line_bytes: 8192
        max_header_bytes: 32768
        max_headers: 100
        max_body_bytes: 1
    body_too_large = match parse_request complete, &body_config
        DecodeResult::Error HttpError::BodyTooLarge => true
        _ => false

    line_config = ServerConfig
        max_request_line_bytes: 3
        max_header_bytes: 32768
        max_headers: 100
        max_body_bytes: 1048576
    line_too_large = match parse_request complete, &line_config
        DecodeResult::Error HttpError::RequestLineTooLarge => true
        _ => false

    output = stdout!
    bad_response_header = (Response::text 200, "hello").with_header "X-Test", "bad\r\nvalue"
    response_header_ok = match write_response &output, &bad_response_header, false
        Result::Err HttpError::InvalidHeader => true
        _ => false
    bad_response_length = (Response::text 200, "hello").with_header "Content-Length", "9"
    response_length_ok = match write_response &output, &bad_response_length, false
        Result::Err HttpError::InvalidHeader => true
        _ => false

    if partial_ok && complete_ok && transfer_ok && conflict_ok && duplicate_ok && version_ok && header_ok && body_too_large && line_too_large && response_header_ok && response_length_ok
        response = (Response::text 200, "hello").with_header "Content-Type", "text/plain"
        written = write_response &output, &response, false
        0
    else
        1
