> stdlib::convert::string_to_int
> stdlib::env::args
> stdlib::net::SocketAddrV4
> stdlib::option::Option
> stdlib::result::Result
> rock_http::request::Request
> rock_http::response::Response
> rock_http::server::Server

handle: Request -> Response
handle = request ->
    target_is_echo = request.target.as_str! == "/echo"
    if target_is_echo
        Response::bytes 200, request.body
    else
        (Response::text 200, "hello from Rock").with_header "Content-Type", "text/plain"

main = ->
    values = args!
    port = match values.get 1
        Option::Some value => string_to_int value.as_str!
        Option::None => 8080
    address = SocketAddrV4::localhost port
    match Server::bind address
        Result::Ok server =>
            result = server.serve handle
            0
        Result::Err _ => 1
