// Bounded incremental HTTP/1 request decoding.

> stdlib::option::Option
> stdlib::result::Result
> stdlib::slice::slice_len
> stdlib::string::byte_substr
> stdlib::string_type::String
> stdlib::vec::Vec
> rock_http::config::ServerConfig
> rock_http::error::HttpError
> rock_http::request::Header
> rock_http::request::Method
> rock_http::request::Request
> rock_http::request::Version

< enum DecodeResult
    Incomplete
    Complete Request, I64
    Error HttpError

enum LengthResult
    Value I64
    Error HttpError

enum HeadersResult
    Value (Vec Header), I64
    Error HttpError

find_crlf: &[U8] -> I64 -> I64 -> I64
find_crlf = bytes, start, end ->
    mut found = 0 - 1
    mut i = start
    while found < 0 && i + 1 < end
        if bytes[i] == (13 as U8) && bytes[i + 1] == (10 as U8)
            found = i
        i = i + 1
    found

find_header_end: &[U8] -> I64
find_header_end = bytes ->
    len = slice_len bytes
    mut found = 0 - 1
    mut i = 0
    while found < 0 && i + 3 < len
        if bytes[i] == (13 as U8) && bytes[i + 1] == (10 as U8) && bytes[i + 2] == (13 as U8) && bytes[i + 3] == (10 as U8)
            found = i
        i = i + 1
    found

find_byte: &[U8] -> I64 -> I64 -> U8 -> I64
find_byte = bytes, start, end, wanted ->
    mut found = 0 - 1
    mut i = start
    while found < 0 && i < end
        if bytes[i] == wanted
            found = i
        i = i + 1
    found

is_token_byte: U8 -> Bool
is_token_byte = byte ->
    value = byte as I64
    (value >= 48 && value <= 57) ||
    (value >= 65 && value <= 90) ||
    (value >= 97 && value <= 122) ||
    value == 33 || value == 35 || value == 36 || value == 37 ||
    value == 38 || value == 39 || value == 42 || value == 43 ||
    value == 45 || value == 46 || value == 94 || value == 95 ||
    value == 96 || value == 124 || value == 126

valid_token: &[U8] -> Bool
valid_token = bytes ->
    len = slice_len bytes
    if len == 0
        false
    else
        mut valid = true
        mut i = 0
        while valid && i < len
            valid = is_token_byte bytes[i]
            i = i + 1
        valid

valid_target: &[U8] -> Bool
valid_target = bytes ->
    len = slice_len bytes
    if len == 0
        false
    else
        mut valid = true
        mut i = 0
        while valid && i < len
            byte = bytes[i]
            value = byte as I64
            valid = value > 32 && value < 127
            i = i + 1
        valid

ascii_lower: U8 -> U8
ascii_lower = byte ->
    value = byte as I64
    if value >= 65 && value <= 90
        (value + 32) as U8
    else
        byte

ascii_eq_literal: &[U8] -> &Str -> Bool
ascii_eq_literal = bytes, literal ->
    literal_bytes = stdlib::string::str_as_bytes literal
    len = slice_len bytes
    if len != (slice_len literal_bytes)
        false
    else
        mut equal = true
        mut i = 0
        while equal && i < len
            equal = bytes[i] == literal_bytes[i]
            i = i + 1
        equal

ascii_eq_literal_ignore_case: &[U8] -> &Str -> Bool
ascii_eq_literal_ignore_case = bytes, literal ->
    literal_bytes = stdlib::string::str_as_bytes literal
    len = slice_len bytes
    if len != (slice_len literal_bytes)
        false
    else
        mut equal = true
        mut i = 0
        while equal && i < len
            equal = (ascii_lower bytes[i]) == (ascii_lower literal_bytes[i])
            i = i + 1
        equal

parse_method: &[U8] -> Method
parse_method = bytes ->
    if ascii_eq_literal bytes, "GET"
        Method::Get
    else if ascii_eq_literal bytes, "HEAD"
        Method::Head
    else if ascii_eq_literal bytes, "POST"
        Method::Post
    else if ascii_eq_literal bytes, "PUT"
        Method::Put
    else if ascii_eq_literal bytes, "DELETE"
        Method::Delete
    else if ascii_eq_literal bytes, "OPTIONS"
        Method::Options
    else if ascii_eq_literal bytes, "PATCH"
        Method::Patch
    else
        Method::Other (String::from_bytes bytes)

parse_version: &[U8] -> Version
parse_version = bytes ->
    if ascii_eq_literal bytes, "HTTP/1.1"
        Version::Http11
    else
        Version::Http10

trim_value_start: &[U8] -> I64 -> I64 -> I64
trim_value_start = bytes, start, end ->
    mut i = start
    while i < end && (bytes[i] == (32 as U8) || bytes[i] == (9 as U8))
        i = i + 1
    i

trim_value_end: &[U8] -> I64 -> I64 -> I64
trim_value_end = bytes, start, end ->
    mut i = end
    while i > start && (bytes[i - 1] == (32 as U8) || bytes[i - 1] == (9 as U8))
        i = i - 1
    i

valid_header_value: &[U8] -> Bool
valid_header_value = bytes ->
    mut valid = true
    mut i = 0
    while valid && i < (slice_len bytes)
        value = bytes[i] as I64
        valid = value == 9 || (value >= 32 && value < 127)
        i = i + 1
    valid

parse_content_length: &[U8] -> LengthResult
parse_content_length = bytes ->
    len = slice_len bytes
    if len == 0
        LengthResult::Error HttpError::InvalidContentLength
    else
        mut value: I64 = 0
        mut valid = true
        mut i = 0
        while valid && i < len
            byte = bytes[i]
            byte_value = byte as I64
            if byte_value < 48 || byte_value > 57
                valid = false
            else
                digit = byte_value - 48
                if value > 922337203685477580 || (value == 922337203685477580 && digit > 7)
                    valid = false
                else
                    value = value * 10 + digit
            i = i + 1
        if valid
            LengthResult::Value value
        else
            LengthResult::Error HttpError::InvalidContentLength

parse_headers: &[U8] -> I64 -> I64 -> &ServerConfig -> HeadersResult
parse_headers = bytes, start, end, config ->
    mut headers: Vec Header = Vec::new!
    mut content_length: Option I64 = Option::None
    mut cursor = start
    while cursor < end
        line_end = find_crlf bytes, cursor, end + 2
        if line_end < cursor
            return HeadersResult::Error HttpError::InvalidHeader
        colon = find_byte bytes, cursor, line_end, (58 as U8)
        if colon <= cursor
            return HeadersResult::Error HttpError::InvalidHeader
        name_bytes = &bytes[cursor..colon]
        if !(valid_token name_bytes)
            return HeadersResult::Error HttpError::InvalidHeader
        value_start = trim_value_start bytes, colon + 1, line_end
        value_end = trim_value_end bytes, value_start, line_end
        value_bytes = &bytes[value_start..value_end]
        if !(valid_header_value value_bytes)
            return HeadersResult::Error HttpError::InvalidHeader

        if headers.len! >= config.max_headers
            return HeadersResult::Error HttpError::TooManyHeaders
        headers.push Header
            name: String::from_bytes name_bytes
            value: String::from_bytes value_bytes

        if ascii_eq_literal_ignore_case name_bytes, "content-length"
            match parse_content_length value_bytes
                LengthResult::Error error => return HeadersResult::Error error
                LengthResult::Value parsed =>
                    match *(&content_length)
                        Option::Some previous =>
                            if previous != parsed
                                return HeadersResult::Error HttpError::ConflictingContentLength
                        Option::None => content_length = Option::Some parsed
        else if ascii_eq_literal_ignore_case name_bytes, "transfer-encoding"
            return HeadersResult::Error HttpError::UnsupportedTransferEncoding

        cursor = line_end + 2
    HeadersResult::Value headers, (content_length.unwrap_or 0)

parse_request: &[U8] -> &ServerConfig -> DecodeResult
< parse_request = bytes, config ->
    len = slice_len bytes
    header_end = find_header_end bytes
    if header_end < 0
        request_line_end = find_crlf bytes, 0, len
        if request_line_end > config.max_request_line_bytes || (request_line_end < 0 && len > config.max_request_line_bytes)
            DecodeResult::Error HttpError::RequestLineTooLarge
        else if len > config.max_header_bytes
            DecodeResult::Error HttpError::HeadersTooLarge
        else
            DecodeResult::Incomplete
    else if header_end + 4 > config.max_header_bytes
        DecodeResult::Error HttpError::HeadersTooLarge
    else
        request_line_end = find_crlf bytes, 0, header_end + 2
        if request_line_end < 0
            DecodeResult::Error HttpError::InvalidRequestLine
        else if request_line_end > config.max_request_line_bytes
            DecodeResult::Error HttpError::RequestLineTooLarge
        else
            first_space = find_byte bytes, 0, request_line_end, (32 as U8)
            second_space = if first_space < 0
                0 - 1
            else
                find_byte bytes, first_space + 1, request_line_end, (32 as U8)
            extra_space = if second_space < 0
                0 - 1
            else
                find_byte bytes, second_space + 1, request_line_end, (32 as U8)
            if first_space <= 0 || second_space <= first_space + 1 || extra_space >= 0
                DecodeResult::Error HttpError::InvalidRequestLine
            else
                method_bytes = &bytes[..first_space]
                target_bytes = &bytes[first_space + 1..second_space]
                version_bytes = &bytes[second_space + 1..request_line_end]
                if !(valid_token method_bytes)
                    DecodeResult::Error HttpError::InvalidMethod
                else if !(valid_target target_bytes)
                    DecodeResult::Error HttpError::InvalidTarget
                else if !(ascii_eq_literal version_bytes, "HTTP/1.1") && !(ascii_eq_literal version_bytes, "HTTP/1.0")
                    DecodeResult::Error HttpError::UnsupportedVersion
                else
                    method = parse_method method_bytes
                    target = String::from_bytes target_bytes
                    version = parse_version version_bytes
                    match parse_headers bytes, request_line_end + 2, header_end, config
                        HeadersResult::Error error => DecodeResult::Error error
                        HeadersResult::Value headers, content_length =>
                            if content_length > config.max_body_bytes
                                DecodeResult::Error HttpError::BodyTooLarge
                            else
                                body_start = header_end + 4
                                available = len - body_start
                                if available < content_length
                                    DecodeResult::Incomplete
                                else
                                    body = byte_substr bytes, body_start, content_length
                                    request = Request
                                        method: method
                                        target: target
                                        version: version
                                        headers: headers
                                        body: body
                                    DecodeResult::Complete request, (body_start + content_length)
