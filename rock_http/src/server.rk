// Blocking one-request-per-connection HTTP serving.

> stdlib::arc::Arc
> stdlib::callable::Fn
> stdlib::clone::Clone
> stdlib::io::Read
> stdlib::io::IoError
> stdlib::net::SocketAddrV4
> stdlib::net::TcpListener
> stdlib::net::TcpStream
> stdlib::result::Result
> stdlib::slice::slice_len
> stdlib::thread::spawn_detached
> stdlib::vec::Vec
> rock_http::config::ServerConfig
> rock_http::error::HttpError
> rock_http::parser::DecodeResult
> rock_http::parser::parse_request
> rock_http::request::Request
> rock_http::response::Response
> rock_http::response::write_response

< struct Server
    listener: TcpListener
    config: ServerConfig

append_bytes: &mut (Vec U8) -> &[U8] -> ()
append_bytes = output, bytes ->
    mut i = 0
    while i < (slice_len bytes)
        output.push bytes[i]
        i = i + 1

read_request: &mut TcpStream -> &ServerConfig -> Result Request, HttpError
read_request = stream, config ->
    mut buffered: Vec U8 = Vec::new!
    mut chunk: [U8; 4096] = [0; 4096]
    while true
        match parse_request buffered.as_slice!, config
            DecodeResult::Complete request, _ => return Result::Ok request
            DecodeResult::Error error => return Result::Err error
            DecodeResult::Incomplete =>
                count = stream.read (&mut chunk)?
                if count <= 0
                    failure: Result Request, HttpError = Result::Err HttpError::ConnectionClosed
                    return failure
                append_bytes &mut buffered, (&chunk[..count])
    Result::Err HttpError::ConnectionClosed

error_response: HttpError -> Response
error_response = error ->
    match error
        HttpError::BodyTooLarge => Response::text 413, "Payload Too Large"
        HttpError::HeadersTooLarge => Response::text 431, "Request Header Fields Too Large"
        HttpError::TooManyHeaders => Response::text 431, "Request Header Fields Too Large"
        HttpError::UnsupportedTransferEncoding => Response::text 501, "Not Implemented"
        _ => Response::text 400, "Bad Request"

serve_connection: TcpStream -> &(Request -> Response) -> &ServerConfig -> Result I64, HttpError
serve_connection = mut stream, handler, config ->
    match read_request (&mut stream), config
        Result::Ok request =>
            head_request = request.is_head!
            response = handler.call request
            write_response &stream, &response, head_request
        Result::Err (HttpError::Io error) => Result::Err (HttpError::Io error)
        Result::Err HttpError::ConnectionClosed => Result::Err HttpError::ConnectionClosed
        Result::Err error =>
            response = error_response error
            write_response &stream, &response, false

worker_unit: () -> ()
worker_unit = -> return

run_worker: TcpStream -> Arc (Request -> Response) -> ServerConfig -> ()
run_worker = stream, handler, config !->
    result = serve_connection stream, &*handler, &config

impl Server
    bind: SocketAddrV4 -> Result Server, HttpError
    bind = address ->
        listener = TcpListener::bind address?
        server = Server
            listener: listener
            config: ServerConfig::default!
        Result::Ok server

    bind_with_config: SocketAddrV4 -> ServerConfig -> Result Server, HttpError
    bind_with_config = address, config ->
        listener = TcpListener::bind address?
        server = Server
            listener: listener
            config: config
        Result::Ok server

    @local_addr: Result SocketAddrV4, IoError
    @local_addr = -> self.listener.local_addr!

    ~@serve: (Request -> Response) -> Result (), HttpError
    ~@serve = handler ->
        shared = Arc::new handler
        while true
            stream = self.listener.accept!?
            worker_handler = shared.clone!
            worker_config = self.config.clone!
            task = -> run_worker stream, worker_handler, worker_config
            spawned = spawn_detached task?
        Result::Ok (worker_unit!)
