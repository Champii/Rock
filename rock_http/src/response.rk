// Owned HTTP response data and constructors.

> stdlib::string_type::String
> stdlib::string::str_as_bytes
> stdlib::vec::Vec
> stdlib::io::Write
> stdlib::io::write_all
> stdlib::io::write_str
> stdlib::option::Option
> stdlib::result::Result
> stdlib::slice::slice_len
> rock_http::error::HttpError
> rock_http::request::Header
> rock_http::request::ascii_eq_ignore_case

< enum Body
    Empty
    Text String
    Bytes (Vec U8)

< struct Response
    < status: I64
    < headers: Vec Header
    < body: Body

impl Response
    new = status ->
        headers: Vec Header = Vec::new!
        Response
            status: status
            headers: headers
            body: Body::Empty

    text = status, value ->
        headers: Vec Header = Vec::new!
        Response
            status: status
            headers: headers
            body: Body::Text (String::from_str value)

    bytes = status, value ->
        headers: Vec Header = Vec::new!
        Response
            status: status
            headers: headers
            body: Body::Bytes value

    ~@with_header = name, value ->
        mut response = self
        response.headers.push (Header::new name, value)
        response

status_reason: I64 -> &Str
status_reason = status ->
    match status
        100 => "Continue"
        200 => "OK"
        201 => "Created"
        202 => "Accepted"
        204 => "No Content"
        301 => "Moved Permanently"
        302 => "Found"
        304 => "Not Modified"
        400 => "Bad Request"
        404 => "Not Found"
        405 => "Method Not Allowed"
        408 => "Request Timeout"
        413 => "Payload Too Large"
        431 => "Request Header Fields Too Large"
        500 => "Internal Server Error"
        501 => "Not Implemented"
        503 => "Service Unavailable"
        _ => "Unknown"

status_forbids_body: I64 -> Bool
status_forbids_body = status ->
    (status >= 100 && status < 200) || status == 204 || status == 304

response_body_len: &Response -> I64
response_body_len = response ->
    match *(&response.body)
        Body::Empty => 0
        Body::Text value => value.len!
        Body::Bytes value => value.len!

response_has_header: &Response -> &Str -> Bool
response_has_header = response, name ->
    mut found = false
    mut i = 0
    while !found && i < response.headers.len!
        header = &response.headers[i]
        found = ascii_eq_ignore_case header.name.as_str!, name
        i = i + 1
    found

valid_header_name: &Str -> Bool
valid_header_name = name ->
    bytes = str_as_bytes name
    len = slice_len bytes
    if len == 0
        false
    else
        mut valid = true
        mut i = 0
        while valid && i < len
            value = bytes[i] as I64
            valid = (value >= 48 && value <= 57) ||
                (value >= 65 && value <= 90) ||
                (value >= 97 && value <= 122) ||
                value == 33 || value == 35 || value == 36 || value == 37 ||
                value == 38 || value == 39 || value == 42 || value == 43 ||
                value == 45 || value == 46 || value == 94 || value == 95 ||
                value == 96 || value == 124 || value == 126
            i = i + 1
        valid

valid_header_value: &Str -> Bool
valid_header_value = value ->
    bytes = str_as_bytes value
    mut valid = true
    mut i = 0
    while valid && i < (slice_len bytes)
        byte = bytes[i] as I64
        valid = byte == 9 || (byte >= 32 && byte < 127)
        i = i + 1
    valid

parse_decimal_header: &Str -> (Bool, I64)
parse_decimal_header = value ->
    bytes = str_as_bytes value
    len = slice_len bytes
    mut parsed: I64 = 0
    mut valid = len > 0
    mut i = 0
    while valid && i < len
        byte = bytes[i] as I64
        if byte < 48 || byte > 57
            valid = false
        else
            digit = byte - 48
            if parsed > 922337203685477580 || (parsed == 922337203685477580 && digit > 7)
                valid = false
            else
                parsed = parsed * 10 + digit
        i = i + 1
    (valid, parsed)

write_header: &W -> &Str -> &Str -> Result I64, HttpError where W: Write
write_header = writer, name, value ->
    mut total = write_str writer, name?
    total = total + (write_str writer, ": "?)
    total = total + (write_str writer, value?)
    total = total + (write_str writer, "\r\n"?)
    Result::Ok total

write_response: &W -> &Response -> Bool -> Result I64, HttpError where W: Write
< write_response = writer, response, head_request ->
    if response.status < 100 || response.status > 999
        failure: Result I64, HttpError = Result::Err HttpError::InvalidStatus
        return failure

    body_len = response_body_len response
    framed_len = if status_forbids_body response.status
        0
    else
        body_len
    mut supplied_length: Option I64 = Option::None
    mut validation_index = 0
    while validation_index < response.headers.len!
        header = &response.headers[validation_index]
        if !(valid_header_name header.name.as_str!) || !(valid_header_value header.value.as_str!)
            failure: Result I64, HttpError = Result::Err HttpError::InvalidHeader
            return failure
        if ascii_eq_ignore_case header.name.as_str!, "transfer-encoding"
            failure: Result I64, HttpError = Result::Err HttpError::InvalidHeader
            return failure
        if ascii_eq_ignore_case header.name.as_str!, "content-length"
            parsed = parse_decimal_header header.value.as_str!
            if !parsed.0 || parsed.1 != framed_len
                failure: Result I64, HttpError = Result::Err HttpError::InvalidHeader
                return failure
            match *(&supplied_length)
                Option::Some previous =>
                    if previous != parsed.1
                        failure: Result I64, HttpError = Result::Err HttpError::InvalidHeader
                        return failure
                Option::None => supplied_length = Option::Some parsed.1
        validation_index = validation_index + 1

    mut total = write_str writer, "HTTP/1.1 "?
    status = String::from_i64 response.status
    total = total + (write_str writer, status.as_str!?)
    total = total + (write_str writer, " "?)
    total = total + (write_str writer, status_reason response.status?)
    total = total + (write_str writer, "\r\n"?)

    mut i = 0
    while i < response.headers.len!
        header = &response.headers[i]
        total = total + (write_header writer, header.name.as_str!, header.value.as_str!?)
        i = i + 1

    if !(response_has_header response, "content-length")
        length = String::from_i64 framed_len
        total = total + (write_header writer, "Content-Length", length.as_str!?)
    if !(response_has_header response, "connection")
        total = total + (write_header writer, "Connection", "close"?)
    total = total + (write_str writer, "\r\n"?)

    if !head_request && !(status_forbids_body response.status)
        match *(&response.body)
            Body::Empty => total = total
            Body::Text value => total = total + (write_all writer, value.as_bytes!?)
            Body::Bytes value => total = total + (write_all writer, value.as_slice!?)

    Result::Ok total
