// HTTP protocol and serving failures.

> stdlib::io::IoError
> stdlib::thread::ThreadError
> stdlib::convert::From

< enum HttpError
    Io IoError
    Thread ThreadError
    ConnectionClosed
    InvalidRequestLine
    InvalidMethod
    InvalidTarget
    UnsupportedVersion
    InvalidHeader
    InvalidContentLength
    ConflictingContentLength
    UnsupportedTransferEncoding
    RequestLineTooLarge
    HeadersTooLarge
    TooManyHeaders
    BodyTooLarge
    InvalidStatus

impl From IoError for HttpError
    from = error -> HttpError::Io error

impl From ThreadError for HttpError
    from = error -> HttpError::Thread error
