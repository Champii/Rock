// Resource limits applied before request allocation can grow without bound.

> stdlib::clone::Clone

< struct ServerConfig
    < max_request_line_bytes: I64
    < max_header_bytes: I64
    < max_headers: I64
    < max_body_bytes: I64

impl ServerConfig
    default = ->
        ServerConfig
            max_request_line_bytes: 8192
            max_header_bytes: 32768
            max_headers: 100
            max_body_bytes: 1048576

impl Clone for ServerConfig
    @clone = ->
        ServerConfig
            max_request_line_bytes: self.max_request_line_bytes
            max_header_bytes: self.max_header_bytes
            max_headers: self.max_headers
            max_body_bytes: self.max_body_bytes
