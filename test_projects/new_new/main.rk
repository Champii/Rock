> stdlib::result::Result
> stdlib::option::Option
> stdlib::net::TcpListener
> stdlib::net::Ipv4Addr
> stdlib::net::SocketAddrV4
> stdlib::net::TcpStream
> stdlib::io::IoError
> stdlib::io::stdin
> stdlib::io::stdout
> stdlib::io::Stdout
> stdlib::env::args
> stdlib::thread::spawn
> stdlib::thread::JoinHandle
> stdlib::thread::ThreadError
> stdlib::arc::Arc
> stdlib::sync::Mutex
> stdlib::clone::Clone

max_clients = -> 64

struct ClientWriter
    < stream: Arc TcpStream
    < lock: Arc (Mutex I64)

struct ServerConnection
    < id: I64
    < writer: ClientWriter

< struct ServerState
    < clients: Vec ServerConnection
    < next_id: I64

struct SharedServerState
    < inner: Arc (Mutex ServerState)

struct ServerClient
    < id: I64
    < stream: Arc TcpStream
    < state: SharedServerState

struct ClientReader
    < stream: Arc TcpStream

impl Clone for ClientWriter
    @clone = ->
        ClientWriter
            stream: self.stream.clone!
            lock: self.lock.clone!

impl Clone for SharedServerState
    @clone = -> SharedServerState
        inner: self.inner.clone!

impl ClientWriter
    @send_all = bytes, len ->
        guard = self.lock.lock!
        self.stream.send_all_prefix bytes, len

impl ServerState
    ^@add = writer ->
        if self.clients.len! < max_clients!
            id = self.next_id
            self.next_id = self.next_id + 1
            self.clients.push 
                ServerConnection
                    id: id
                    writer: writer
            Option::Some id
        else
            Option::None

    ^@remove = id -> self.clients.retain (.id != id)

    @snapshot = -> self.clients.map_ref (.writer.clone!)

impl SharedServerState
    new = state ->
        SharedServerState
            inner: Arc::new Mutex::new state

    @add = writer ->
        mut guard = self.inner.lock!
        guard.add writer

    @remove = id ->
        mut guard = self.inner.lock!
        guard.remove id

broadcast = state, bytes, len ->
    payload: &[U8] = bytes
    count: I64 = len
    guard = state.inner.lock!
    guard.snapshot!.for_each_owned target !-> target.send_all payload, count
    Result::Ok count

receive_with = stream, mut target, write ->
    client_stream: Arc TcpStream = stream
    mut buff: [U8; 1024] = [0; 1024]
    mut total: I64 = 0
    while true
        match client_stream.recv &mut buff
            Result::Ok count =>
                if count <= 0
                    return total
                else
                    written_result: Result I64, IoError = write &mut target, &buff, count
                    match written_result
                        Result::Ok written => total = total + written
                        Result::Err _ => return total
            Result::Err _ => return total
    total

impl ServerClient
    ~@run = ->
        total = receive_with self.stream.clone!, self.state.clone!, broadcast
        id = self.id
        self.state.remove id
        total

impl ClientReader
    ~@run = -> receive_with self.stream.clone!, stdout!, Stdout::write_all_prefix

listen = ->
    addr = Ipv4Addr::localhost!
    addr2 = SocketAddrV4::new addr, 9999
    TcpListener::bind addr2 >>= run_listener

run_listener = listener ->
    state = SharedServerState::new ServerState
        clients: Vec::new!
        next_id: 0
    mut handlers = Vec::new!
    mut accepted: I64 = 0

    while true
        accepted_client: Result (Option (JoinHandle I64)), IoError = listener.accept! <&> start_client state.clone!
        handler = accepted_client?
        started: I64 = handler.fold
            0
            handle ->
                handlers.push handle
                1
        accepted = accepted + started

    Result::Ok accepted

start_client = state, accepted_stream ~>
    stream = Arc::new accepted_stream
    writer = ClientWriter
        stream: stream.clone!
        lock: Arc::new Mutex::new 0

    state.add writer >>= id ->
        client = ServerClient
            id: id
            stream: stream
            state: state.clone!
        spawned = spawn (-> client.run!)
        spawned.fold
            _ ->
                state.remove id
                Option::None
            Option::Some _

connect = ->
    addr = Ipv4Addr::localhost!
    addr2 = SocketAddrV4::new addr, 9999
    TcpStream::connect addr2 >>= run_connection

run_connection = stream ->
    shared = Arc::new stream
    reader = ClientReader
        stream: shared.clone!
    spawn (-> reader.run!)
        <!> thread_error_to_io
        >>= finish_connection (shared.clone!)

finish_connection = stream, handle ~>
    client_stream: Arc TcpStream = stream
    join_handle: JoinHandle I64 = handle
    total_result: Result I64, IoError = pump_stdin client_stream.clone!
    total = total_result?
    stopped_result: Result Unit, IoError = client_stream.shutdown_write!
    stopped = stopped_result?
    result: Result I64, IoError = join_handle.join!
        <!> thread_error_to_io
        <&> _ -> total
    result

pump_stdin = stream ->
    stdin! |>> &stream

thread_error_to_io = _ -> IoError::Os 1

run_mode = mode ->
    match mode.as_str!
        "listen" => listen!
        "connect" => connect!
        _ => Result::Err IoError::Os 1

main = ->
    values = args!
    values.println!
    res: Result I64, IoError = values.get 1 .fold
        Result::Err IoError::Os 1
        run_mode

    res.println!
    0
