> stdlib::result::Result
> stdlib::option::Option
> stdlib::net::TcpListener
> stdlib::net::Ipv4Addr
> stdlib::net::SocketAddrV4
> stdlib::net::TcpStream
> stdlib::io::IoError
> stdlib::io::stdin
> stdlib::io::stdout
> stdlib::io::Stdout
> stdlib::env::args
> stdlib::thread::spawn
> stdlib::thread::JoinHandle
> stdlib::thread::ThreadError
> stdlib::arc::Arc
> stdlib::sync::Mutex
> stdlib::clone::Clone

max_clients = -> 64

struct ClientWriter
    < stream: Arc TcpStream
    < lock: Arc (Mutex I64)

struct ServerConnection
    < id: I64
    < writer: ClientWriter

< struct ServerState
    < clients: Vec ServerConnection
    < next_id: I64

struct SharedServerState
    < inner: Arc (Mutex ServerState)

struct ServerClient
    < id: I64
    < stream: Arc TcpStream
    < state: SharedServerState

struct ClientReader
    < stream: Arc TcpStream

impl Clone for ClientWriter
    @clone = ->
        ClientWriter
            stream: self.stream.clone!
            lock: self.lock.clone!

impl Clone for SharedServerState
    @clone = -> SharedServerState
        inner: self.inner.clone!

impl ClientWriter
    @send_all = bytes, len ->
        guard = self.lock.lock!
        self.stream.send_all_prefix bytes, len

impl ServerState
    ^@add = writer ->
        if self.clients.len! < max_clients!
            id = self.next_id
            self.next_id = self.next_id + 1
            self.clients.push 
                ServerConnection
                    id: id
                    writer: writer
            Option::Some id
        else
            Option::None

    ^@remove = id -> self.clients.retain (.id != id)

    @snapshot = -> self.clients.map_ref (.writer.clone!)

impl SharedServerState
    new = state ->
        SharedServerState
            inner: Arc::new Mutex::new state

    @add = writer ->
        mut guard = self.inner.lock!
        guard.add writer

    @remove = id ->
        mut guard = self.inner.lock!
        guard.remove id

broadcast = state, bytes, len ->
    count = len
    guard = state.inner.lock!
    guard.snapshot!.try_for_each (target ->
        target.send_all bytes, count <&> (_ !-> 0))
        <&> _ -> len

receive_with = stream, mut target, write ->
    mut buff = [0; 1024]
    mut total = 0
    while true
        match stream.recv &mut buff
            Result::Ok count =>
                if count <= 0
                    return total
                else
                    written_result = write &mut target, &buff, count
                    match written_result
                        Result::Ok written => total = total + written
                        Result::Err _ => return total
            Result::Err _ => return total
    total

impl ServerClient
    ~@run = ->
        total = receive_with self.stream.clone!, self.state.clone!, broadcast
        id = self.id
        self.state.remove id
        total

impl ClientReader
    ~@run = -> receive_with self.stream.clone!, stdout!, Stdout::write_all_prefix

server_addr = -> SocketAddrV4::new Ipv4Addr::localhost!, 9999

listen = -> TcpListener::bind server_addr! >>= run_listener

run_listener = listener ->
    state = SharedServerState::new ServerState
        clients: Vec::new!
        next_id: 0
    mut handlers = Vec::new!
    mut accepted = 0

    while true
        accepted_client = listener.accept! <&> start_client state.clone!
        handler = accepted_client?
        started = handler.fold
            0
            handle ->
                handlers.push handle
                1
        accepted = accepted + started

    Result::Ok accepted

start_client = state, accepted_stream ~>
    stream = Arc::new accepted_stream
    writer = ClientWriter
        stream: stream.clone!
        lock: Arc::new Mutex::new 0

    state.add writer >>= id ->
        client = ServerClient
            id: id
            stream: stream
            state: state.clone!
        spawn (-> client.run!) .fold
            _ ->
                state.remove id
                Option::None
            Option::Some _

connect = -> TcpStream::connect server_addr! >>= run_connection

run_connection = stream ->
    shared = Arc::new stream
    reader = ClientReader
        stream: shared.clone!
    spawn (-> reader.run!)
        <!> thread_error_to_io
        >>= finish_connection (shared.clone!)

finish_connection = stream, handle ~>
    total = pump_stdin &stream?
    stream.shutdown_write!?
    handle.join!
        <!> thread_error_to_io
        <&> _ -> total

pump_stdin = stream ->
    stdin! |>> stream

thread_error_to_io = _ -> IoError::Os 1

run_mode = mode ->
    match mode.as_str!
        "listen" => listen!
        "connect" => connect!
        _ => Result::Err IoError::Os 1

main = ->
    values = args!
    values.println!
    res = values.get 1 !> IoError::Os 1 >>= run_mode

    res.println!
    0
