; Example Rock file for testing tree-sitter

struct Point
    x: Int
    y: Int

enum Color
    Red
    Green
    Blue

trait Display
    @show: String

impl Display for Point
    @show = -> "Point"

add = x, y -> x + y

main = ->
    point = Point
        x: 10
        y: 20

    if point.x > 0
    then point.x
    else 0

    for i in [1, 2, 3]
        i * 2

    match point
        Point x: 0, y: 0 => "origin"
        Point x: x, y: y => "point"

    result = add 1, 2
