lang control_flow
< enum ControlFlow B, C
    lang break
    Break B
    lang continue
    Continue C

lang try
< trait Try
    lang output
    type Output
    lang residual
    type Residual
    lang branch
    ~@branch: ControlFlow Self::Residual, Self::Output

lang from_residual
< trait FromResidual R
    lang method
    from_residual: R -> Self
