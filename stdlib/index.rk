> stdlib::libc::exit
> stdlib::libc::puts
> stdlib::sized::Sized

lang index
< trait Index Idx
    lang output
    type Output
    lang method
    @index: Idx -> &Self::Output

lang index_mut
< trait IndexMut Idx
    lang output
    type Output
    lang method
    ^@index_mut: Idx -> &mut Self::Output

index_bounds_check: I64 -> I64 -> Unit
index_bounds_check = index, len ->
    if index < 0 || index >= len
        puts (~ArrPtr "index out of bounds")
        exit (1 as I32)

impl Index I64 for &[T]
    type Output = T
    @index = i ->
        slice = *self
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &*(~PtrOffset ptr, i)

impl IndexMut I64 for &mut [T]
    type Output = T
    ^@index_mut = i ->
        slice = &*self
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &mut *(~PtrOffset ptr, i)

impl Index I64 for *T where T: Sized
    type Output = T
    unsafe @index = i -> unsafe &*(~PtrOffset *self, i)

impl IndexMut I64 for *T where T: Sized
    type Output = T
    unsafe ^@index_mut = i -> unsafe &mut *(~PtrOffset *self, i)

impl Index I64 for *[T]
    type Output = T
    unsafe @index = i ->
        slice = unsafe *(*self)
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &*(~PtrOffset ptr, i)

impl IndexMut I64 for *[T]
    type Output = T
    unsafe ^@index_mut = i ->
        slice = unsafe *(*self)
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &mut *(~PtrOffset ptr, i)
