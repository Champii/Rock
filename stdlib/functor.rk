// Functor maps a consuming callback over a type constructor.

> stdlib::callable::FnMut

< trait Functor for F _
    fmap: M -> F A -> F B where M: FnMut A, B

<$>: (A -> B) -> F A -> F B where F _: Functor
<$> = mapper, value -> F::Functor::fmap mapper, value

<&>: F A -> (A -> B) -> F B where F _: Functor
<&> = value, mapper -> F::Functor::fmap mapper, value
