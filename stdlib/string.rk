// String functions
//
// These functions provide string manipulation capabilities.
// Higher-level operations are implemented in pure Rock using low-level intrinsics.
// Note: Use curried form for externs (A -> B -> C)

> stdlib::string_type::String
> stdlib::vec::Vec

// Extract raw pointer from &Str fat pointer
str_raw_ptr: &Str -> *U8
< str_raw_ptr = s -> ~ArrPtr s

// Get the byte length of a UTF-8 string slice
string_len: &Str -> I64
< string_len = s -> ~ArrayLen s

// Get the byte at index idx in a byte slice
byte_at: &[U8] -> I64 -> U8
< byte_at = s, idx ->
    p = ~ArrPtr s
    unsafe p[idx]

// Concatenate two string slices. Concatenating valid UTF-8 preserves UTF-8 validity.
string_concat: &Str -> &Str -> String
< string_concat = a, b -> a + b

// Extract byte substring starting at `start` with length `len`
byte_substr: &[U8] -> I64 -> I64 -> Vec U8
< byte_substr = s, start, len ->
    mut out = Vec::new!
    i = 0
    ptr = ~ArrPtr s
    while i < len
        out.push (unsafe ptr[start + i])
        i = i + 1
    out

// Find needle in haystack; returns byte offset or -1 if not found
string_find: &Str -> &Str -> I64
< string_find = haystack, needle ->
    h_ptr = ~ArrPtr haystack
    h_len = ~ArrayLen haystack
    n_ptr = ~ArrPtr needle
    n_len = ~ArrayLen needle
    if n_len == 0
        0
    else if n_len > h_len
        0 - 1
    else
        max_start = h_len - n_len
        i = 0
        found = 0 - 1
        while found < 0 && i <= max_start
            j = 0
            matches = true
            while matches && j < n_len
                h_byte = (unsafe h_ptr[i + j]) as I64
                n_byte = (unsafe n_ptr[j]) as I64
                if h_byte != n_byte
                    matches = false
                j = j + 1
            if matches
                found = i
            i = i + 1
        found

// Return 1 if haystack contains needle, 0 otherwise
string_contains: &Str -> &Str -> I64
< string_contains = haystack, needle ->
    idx = string_find haystack, needle
    if idx >= 0
        1
    else
        0
