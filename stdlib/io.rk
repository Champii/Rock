// Portable IO traits and errors.

> stdlib::libc::__errno_location
> stdlib::libc::read
> stdlib::libc::write
> stdlib::arc::Arc
> stdlib::result::Result
> stdlib::show::Show
> stdlib::string_type::String

< enum IoError
    Os I32
    InvalidPath
    InvalidAddress
    InvalidInput

< struct Stdin

< struct Stdout

< last_os_error = ->
    ptr = __errno_location!
    IoError::Os (unsafe *ptr)

< trait Read
    ^@read: &mut [U8] -> Result I64, IoError

< trait Write
    @write: &[U8] -> Result I64, IoError
    @write_str: &Str -> Result I64, IoError
    @write_all_prefix: &[U8] -> I64 -> Result I64, IoError

impl Write for Arc W where W: Write
    @write = buf -> (*(*self)).write buf
    @write_str = value -> (*(*self)).write_str value
    @write_all_prefix = buf, len -> (*(*self)).write_all_prefix buf, len

< stdin = -> Stdin

< stdout = -> Stdout

impl Stdin
    ^@read_bytes: &mut [U8] -> Result I64, IoError
    ^@read_bytes = buf ->
        count = read 0, (~ArrPtr *buf), (~ArrayLen *buf)
        if count < 0
            Result::Err (last_os_error!)
        else
            Result::Ok count

impl Read for Stdin
    ^@read = buf -> self.read_bytes buf

copy: &mut R -> &W -> Result I64, IoError where R: Read, W: Write
< copy = source, target ->
    mut buffer: [U8; 8192] = [0; 8192]
    mut total: I64 = 0
    mut done = false
    while !done
        read_result: Result I64, IoError = source.read (&mut buffer)
        count: I64 = read_result?
        if count <= 0
            done = true
        else
            write_result: Result I64, IoError = target.write_all_prefix (&buffer), count
            written: I64 = write_result?
            if written <= 0
                done = true
            else
                total = total + written
    Result::Ok total

|>>: R -> &W -> Result I64, IoError where R: Read, W: Write
|>> = mut source, target -> copy (&mut source), target

impl Stdout
    ^@write_prefix: &[U8] -> I64 -> Result I64, IoError
    ^@write_prefix = buf, len ->
        if len < 0 || len > (~ArrayLen buf)
            err = IoError::InvalidInput
            Result::Err err
        else
            count = write 1, (~ArrPtr buf), len
            if count < 0
                Result::Err (last_os_error!)
            else
                Result::Ok count

    ^@write_all_prefix: &[U8] -> I64 -> Result I64, IoError
    ^@write_all_prefix = buf, len ->
        if len < 0 || len > (~ArrayLen buf)
            err = IoError::InvalidInput
            Result::Err err
        else
            mut total: I64 = 0
            mut failed = false
            mut failure = IoError::Os (0 as I32)
            while total < len && !failed
                ptr: *U8 = unsafe ~PtrOffset (~ArrPtr buf), total
                remaining: I64 = len - total
                count: I64 = write 1, ptr, remaining
                if count < 0
                    failure = last_os_error!
                    failed = true
                else if count == (0 as I64)
                    failure = IoError::Os (5 as I32)
                    failed = true
                else
                    total = total + count
            if failed
                Result::Err failure
            else
                Result::Ok total

impl Show for IoError
    @show = -> String::from_str "IoError"
