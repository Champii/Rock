{
  "name": "rock-language",
  "displayName": "Rock Language",
  "description": "Rock analysis with rock-lsp and highlighting with tree-sitter-rock.",
  "version": "0.1.0",
  "publisher": "champii",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Rock-lang-org/Rock.git" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Rock analysis can build project dependencies." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [{ "id": "rock", "aliases": ["Rock", "rock"], "extensions": [".rk"], "configuration": "./language-configuration.json" }],
    "configuration": {
      "title": "Rock",
      "properties": {
        "rock.server.path": { "type": "string", "default": "rock-lsp", "scope": "machine-overridable", "description": "Path to rock-lsp, or its command name on PATH. Relative paths resolve against the workspace folder. Reload the window after changing." },
        "rock.server.args": { "type": "array", "items": { "type": "string" }, "default": [], "scope": "window", "description": "Arguments for rock-lsp, such as --extern-artifact and name=/absolute/path. Reload the window after changing." }
      }
    },
    "configurationDefaults": { "[rock]": { "editor.semanticHighlighting.enabled": true } },
    "themes": [
      { "label": "Rock Book Dark", "uiTheme": "vs-dark", "path": "./dist/rock-dark.json" },
      { "label": "Rock Book Light", "uiTheme": "vs", "path": "./dist/rock-light.json" }
    ],
    "semanticTokenTypes": [
      { "id": "rockReceiver", "superType": "variable", "description": "Rock receiver markers such as ~@." },
      { "id": "rockAssignment", "superType": "operator", "description": "Rock assignment signs." },
      { "id": "rockArrow", "superType": "operator", "description": "Rock function and match arrows." },
      { "id": "rockPunctuation", "superType": "operator", "description": "Rock brackets, separators, and access punctuation." },
      { "id": "rockAnnotation", "superType": "operator", "description": "Rock type and field annotation colons." },
      { "id": "rockCall", "superType": "operator", "description": "Rock call and propagation suffixes." },
      { "id": "rockIntrinsic", "superType": "function", "description": "Explicit Rock compiler intrinsic calls." },
      { "id": "rockBoolean", "superType": "keyword", "description": "Rock boolean literals." }
    ],
    "semanticTokenScopes": [{
      "language": "rock",
      "scopes": {
        "comment": ["comment"], "keyword": ["keyword"], "number": ["constant.numeric"],
        "string": ["string"], "operator": ["keyword.operator"], "function": ["entity.name.function"],
        "macro": ["entity.name.function.preprocessor"], "variable": ["variable.other.readwrite"],
        "type": ["entity.name.type"], "property": ["variable.other.property"], "decorator": ["entity.other.attribute-name"],
        "parameter": ["variable.parameter"], "enumMember": ["variable.other.enummember"], "namespace": ["entity.name.namespace"],
        "rockReceiver": ["variable.language"], "rockAssignment": ["keyword.operator.assignment"],
        "rockArrow": ["storage.type.function.arrow", "keyword.operator"], "rockPunctuation": ["punctuation"],
        "rockAnnotation": ["punctuation.separator.key-value"], "rockCall": ["keyword.operator"],
        "rockIntrinsic": ["support.function"], "rockBoolean": ["constant.language.boolean"]
      }
    }]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": { "vscode-languageclient": "^9.0.1", "web-tree-sitter": "0.27.0" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/vscode": "^1.85.0", "@vscode/vsce": "^3.0.0", "esbuild": "^0.25.0", "tree-sitter-cli": "0.27.0", "typescript": "^5.0.0" },
  "allowScripts": { "tree-sitter-cli": true, "esbuild": true }
}
