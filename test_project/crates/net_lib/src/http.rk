// HTTP utilities

// HTTP methods
enum Method
    GET
    POST
    PUT
    DELETE

// HTTP Response
struct Response
    status: I64
    body: String

// HTTP Request
struct Request
    method: String
    path: String
    body: String

// Mock request for testing
mock_request = method, path ->
    "Response: " + method + " " + path

// Create a GET request
get_request = path -> Request "GET" path ""

// Create a POST request
post_request = path, body -> Request "POST" path body

// Check if response is successful (2xx)
is_success = response -> response.status >= 200 && response.status < 300
